# Copie para .env (gitignored) e preencha. Nunca commite valores.
# Em produção (ops/compose.yaml) segredos vêm de arquivos em ops/secrets/ montados em /run/secrets/<nome>;
# a aplicação lê VAR ou VAR_FILE (caminho do arquivo). Ex.: MONGODB_URI_FILE=/run/secrets/mongo_uri

# --- Banco ---
MONGODB_URI=
MONGODB_URI_TEST=
MONGODB_DB=

# --- Evento / URLs ---
EVENT_ID=
PUBLIC_BASE_URL=
PORT=
NODE_ENV=

# --- Auth ---
JWT_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Turnstile (E02, E05) ---
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# --- E-mail (canal obrigatório) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# --- WhatsApp Business Cloud API (opcional; vazio desliga o canal) ---
WHATSAPP_ENABLED=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Cloudflare Tunnel (só compose.yaml de produção) ---
CF_TUNNEL_TOKEN=
