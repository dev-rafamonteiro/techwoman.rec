# Copie para .env (gitignored) e preencha. Nunca commite valores.
# Em produção (ops/compose.yaml) segredos vêm de arquivos em ops/secrets/ montados em /run/secrets/<nome>;
# a aplicação lê VAR ou VAR_FILE (caminho do arquivo). Ex.: MONGODB_URI_FILE=/run/secrets/mongo_uri

# --- Banco ---
MONGODB_URI=
MONGODB_URI_TEST=
MONGODB_DB=

# --- Evento / URLs ---
EVENT_ID=
PUBLIC_BASE_URL=
PORT=
NODE_ENV=
ALLOWED_ORIGINS=           # lista separada por vírgula, além de PUBLIC_BASE_URL
TRUST_PROXY=
COOKIE_SECURE=
LOG_LEVEL=

# --- Auth ---
JWT_SECRET=                # mínimo 32 caracteres
MENTEE_TOKEN_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Turnstile (E02, E05) ---
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
# Chave pública embutida no build do front (build-arg do web.Dockerfile)
VITE_TURNSTILE_SITE_KEY=

# --- Analytics (Umami, stack em ops/analytics/; lido em runtime pelo web; UMAMI_WEBSITE_ID vazio = desligado) ---
UMAMI_HOST_URL=            # https://analytics.techwoman.dev (sem barra final)
UMAMI_WEBSITE_ID=          # UUID do site no painel do Umami

# --- E-mail (canal obrigatório): EMAIL_PROVIDER=resend envia pelo Resend; vazio só registra em log ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_TRANSPORT=           # smtp | ses | resend (smtp em dev = Mailpit)
SMTP_HOST=                 # dev: mailpit (containers) ou 127.0.0.1 (host)
SMTP_PORT=                 # dev: 1025
SMTP_USER=                 # opcional (dev/Mailpit não usa)
SMTP_PASS=                 # opcional; ou SMTP_PASS_FILE (caminho do arquivo)
SMTP_PASS_FILE=
SMTP_SECURE=               # opcional: true = TLS direto
AWS_REGION=                # só com EMAIL_TRANSPORT=ses
EMAIL_FROM=                # Tech Woman <mentoria@techwoman.dev>
EMAIL_REPLY_TO=
EMAIL_MAX_PER_SEC=         # worker: e-mails por segundo (padrão 8, abaixo dos 10/s do Resend; 0 = sem limite)
EMAIL_CONCURRENCY=         # worker: envios de e-mail simultâneos (padrão 4)

# --- Chave da outbox (AES-256-GCM da senha provisória): 32 bytes em base64; produção usa OUTBOX_KEY_FILE ---
OUTBOX_KEY=                # ou OUTBOX_KEY_FILE (produção: /run/secrets/outbox_key)
OUTBOX_KEY_FILE=

# --- Cloudflare Tunnel (só compose.yaml de produção) ---
CF_TUNNEL_TOKEN=
