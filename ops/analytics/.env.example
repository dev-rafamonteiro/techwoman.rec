# Copie para ops/analytics/.env (gitignored) e preencha. Nunca commite valores. Ver docs/PLAN.md > Analytics (Umami).
# Senha do Postgres do Umami (hex, para caber no DATABASE_URL sem escape): openssl rand -hex 24
UMAMI_DB_PASSWORD=
# APP_SECRET do Umami (assina as sessões do painel): openssl rand -hex 32
UMAMI_APP_SECRET=
# Limites (opcionais; padrões 1.0 / 768M e 0.5 / 512M). No dia do evento, suba aqui e rode o "up -d" de novo.
UMAMI_CPUS=
UMAMI_MEM=
UMAMI_DB_CPUS=
UMAMI_DB_MEM=
